# Template — copy to .env and fill in. Never put real values in this file:
# .env.example is committed, .env is not.

# PIN for Template Manager (/admin). Checked on the server — every template
# create, edit and delete must present it. Set this in Vercel → Settings →
# Environment Variables. Without it the API refuses all writes.
ADMIN_PIN=change-me

# Injected automatically when you create a Blob store in Vercel → Storage.
# Without it, templates live only in the admin's own browser and the public
# links will not open for anyone else.
BLOB_READ_WRITE_TOKEN=
